# ===================================================
# CHIRO UI LICENSE CENTER - ENVIRONMENT CONFIGURATION
# ===================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://chiro_admin:your_secure_password@localhost:5432/chiro_licenses?schema=public

# Security Secrets (Generate using: openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_characters
ADMIN_SESSION_SECRET=replace_with_a_secure_random_session_secret_key_at_least_32_characters

# CORS Settings (Comma-separated for multiple origins, or * for public API access)
CORS_ORIGIN=http://localhost:5173,https://chiro-license-center.onrender.com

# Server Environment & Port
NODE_ENV=production
PORT=10000

# Initial Admin Account Setup (Used for database seed)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@chiro.local
INITIAL_ADMIN_PASSWORD=ChangeThisSecurePassword2026!

# Public Client Configuration (Roblox / Luau Rate Limiting)
CLIENT_RATE_LIMIT_WINDOW_MS=60000
CLIENT_RATE_LIMIT_MAX_REQUESTS=60
